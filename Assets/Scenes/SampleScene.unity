--- !u!114 &2035695169
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2035695164}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b3eb41bc0afd554aa959b87b2ec0929, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  day: {fileID: 1465347525}
  messages:
  - 0
  - "\u0412 \u0441\u0442\u043E\u043B\u043E\u0432\u043E\u0439 \u043F\u0430\u0445\u043D\u0435\u0442
    \u0435\u0434\u043E\u0439. \u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
    \u0440\u043E\u0432\u043D\u043E \u0433\u0443\u0434\u0438\u0442. \u0412\u044B\u0431\u0435\u0440\u0443
    \u0447\u0442\u043E \u043F\u043E\u0432\u043A\u0443\u0441\u043D\u0435\u0435. \u0412
    \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u0438 \u0447\u0442\u043E-\u0442\u043E
    \u0443\u043F\u0430\u043B\u043E \u0438\u043B\u0438 \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F?
    \u041F\u043B\u0435\u0432\u0430\u0442\u044C, \u0421\u043E\u043A\u043E\u043B\u043E\u0432\u0430
    \u0434\u043E\u043B\u0436\u043D\u0430 \u0441\u0430\u043C\u0430 \u0441\u043B\u0435\u0434\u0438\u0442\u044C
    \u0437\u0430 \u0441\u0432\u043E\u0438\u043C \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u043E\u043C."
  - "\u041F\u0430\u0445\u043D\u0435\u0442 \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E
    \u043D\u0435 \u0442\u0430\u043A \u0441\u0432\u0435\u0436\u043E. \u041B\u0430\u043C\u043F\u043E\u0447\u043A\u0430
    \u043C\u043E\u0440\u0433\u043D\u0443\u043B\u0430. \u041D\u0430\u0434\u043E \u0431\u044B
    \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C, \u043D\u043E \u043F\u043E\u0442\u043E\u043C.
    \u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432, \u044F
    \u0436\u0435 \u043D\u0435 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0442\u0430\u043C
    \u043F\u0430\u043D\u0438\u043A\u0451\u0440. \u0421\u0430\u043C\u0438 \u0432\u0441\u0451
    \u0443\u0432\u0438\u0434\u044F\u0442. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
    \u043F\u043E\u0434\u043A\u0440\u0435\u043F\u043B\u044E\u0441\u044C."
  - "\u041E\u0442\u0440\u044B\u043B \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u044B
    \u0432 \u0443\u0433\u043B\u0443 \u0441\u0442\u043E\u043B\u043E\u0432\u043E\u0439
    \u0442\u0443\u043C\u0431\u043E\u0447\u043A\u0438. \u0418\u0445 \u043A\u0442\u043E-\u0442\u043E
    \u0442\u0443\u0442 \u0441\u043F\u0440\u044F\u0442\u0430\u043B? \u041D\u0443 \u0438
    \u0436\u0430\u0434\u0438\u043D\u0430. \u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
    \u0432\u0441\u044E \u043D\u043E\u0447\u044C \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E
    \u0442\u0430\u0440\u0430\u0445\u0442\u0435\u043B, \u043D\u0435 \u0434\u0430\u0432\u0430\u043B
    \u0432\u044B\u0441\u043F\u0430\u0442\u044C\u0441\u044F. \u0418\u0434\u0438\u043E\u0442\u044B
    \u0441 \u043A\u0440\u0438\u0432\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438.
    \u0418\u0437-\u0437\u0430 \u043D\u0438\u0445 \u044F \u043D\u0435 \u0432\u044B\u0441\u044B\u043F\u0430\u044E\u0441\u044C."
  - "\u0412\u043E\u043D\u044F\u0435\u0442 \u0441\u044B\u0440\u043E\u0441\u0442\u044C\u044E.
    \u0415\u0441\u0442\u044C \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F
    \u0441\u043E\u0432\u0441\u0435\u043C, \u0442\u043E\u0448\u043D\u043E. \u0412\u0441\u0451
    \u043E\u0449\u0443\u0449\u0430\u0435\u0442\u0441\u044F \u0442\u0430\u043A\u0438\u043C
    \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C\u2026 \u0412\u043E\u0434\u0430
    \u043A\u0430\u043F\u0430\u0435\u0442 \u0438\u0437 \u043A\u0440\u0430\u043D\u0430.
    \u041A\u0430\u043A \u043E\u043D\u0438 \u043C\u043E\u0433\u043B\u0438 \u0434\u043E\u0432\u0435\u0441\u0442\u0438
    \u0432\u0441\u0451 \u0434\u043E \u0442\u0430\u043A\u043E\u0433\u043E? \u041D\u0438\u043A\u0442\u043E
    \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442!
    \u042F \u043D\u0435 \u0432\u0438\u043D\u043E\u0432\u0430\u0442, \u0447\u0442\u043E
    \u043E\u043D\u0438 \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F!"
  - "\u0410\u043B\u0435\u043A\u0441\u0435\u0439 \u043F\u0440\u0438\u043D\u0451\u0441
    \u0441\u0432\u043E\u0451 \u044F\u0431\u043B\u043E\u043A\u043E. \u041C\u043E\u043B\u0447\u0430
    \u0443\u0448\u0451\u043B. \u0421\u0434\u0430\u043B\u043E\u0441\u044C \u043C\u043D\u0435
    \u0442\u0432\u043E\u0451 \u044F\u0431\u043B\u043E\u043A\u043E, \u043B\u0443\u0447\u0448\u0435
    \u0431\u044B \u043F\u043E\u043B\u043E\u043C\u043A\u0443 \u043D\u0430\u0448\u0451\u043B!
    \u0412 \u0443\u0433\u043B\u0443 \u043A\u043E\u043C\u043D\u0430\u0442\u044B \u0447\u0442\u043E-\u0442\u043E
    \u043F\u043E\u043B\u0437\u0430\u0435\u0442. \u042D\u0442\u043E \u0442\u0430\u0440\u0430\u043A\u0430\u043D.
    \u0413\u0430\u0434\u043E\u0441\u0442\u044C."
  - "\u0412 \u0433\u0438\u0434\u0440\u043E\u043F\u043E\u043D\u0438\u043A\u0435 \u0432\u043E\u043D\u044F\u0435\u0442.
    \u0422\u0438\u0448\u0438\u043D\u0430 \u0441\u0432\u043E\u0434\u0438\u0442 \u0441
    \u0443\u043C\u0430. \u0423\u043C\u0438\u0440\u0430\u044E \u043E\u0442 \u0433\u043E\u043B\u043E\u0434\u0430.
    \u042F \u0441\u043A\u0440\u0438\u043F\u043B\u044E \u0437\u0443\u0431\u0430\u043C\u0438
    \u0438 \u043D\u0435 \u043C\u043E\u0433\u0443 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F.
    \u041D\u0430\u0448\u0451\u043B \u0434\u043E\u0445\u043B\u0443\u044E \u0432\u043E\u043D\u044E\u0447\u0443\u044E
    \u043A\u0440\u044B\u0441\u0443. \u042D\u0442\u043E \u0432\u0441\u0451 \u043E\u043D\u0438.
    \u0414\u043E\u0432\u0435\u043B\u0438. \u0418\u0437-\u0437\u0430 \u0438\u0445
    \u0431\u0435\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u044F \u0441\u0435\u0439\u0447\u0430\u0441
    \u0431\u0443\u0434\u0443 \u0435\u0441\u0442\u044C \u044D\u0442\u043E?"
  - "\u0418\u0432\u0430\u043D\u043E\u0432 \u0438 \u0421\u043E\u043A\u043E\u043B\u043E\u0432\u0430
    \u0441\u043F\u043E\u0440\u044F\u0442 \u043E \u043F\u043E\u043B\u043E\u043C\u043A\u0435.
    \u0411\u0435\u0437\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u0438. \u041D\u0430\u0434\u043E
    \u0431\u044B\u043B\u043E \u0447\u0438\u043D\u0438\u0442\u044C \u0441\u0440\u0430\u0437\u0443,
    \u0430 \u043D\u0435 \u0436\u0434\u0430\u0442\u044C. \u042D\u0442\u043E \u0438\u0445
    \u0432\u0438\u043D\u0430. \u0412\u0441\u0451 \u044D\u0442\u043E \u0438\u0437-\u0437\u0430
    \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u043E\u043D\u0438 \u043F\u043B\u043E\u0445\u043E
    \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0442 \u0437\u0430 \u0441\u0432\u043E\u0438
    \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438. \u0410\u043B\u0435\u043A\u0441\u0435\u0439
    \u0448\u0435\u043F\u0447\u0435\u0442 \u0447\u0442\u043E-\u0442\u043E. \u041E\u043D\u0438
    \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043D\u0430 \u043C\u0435\u043D\u044F."
  - "\u041F\u0430\u0445\u043D\u0435\u0442 \u0441\u043C\u0435\u0440\u0442\u044C\u044E.
    \u041D\u0438\u043A\u043E\u0433\u043E \u043D\u0435\u0442. \u0422\u043E\u043B\u044C\u043A\u043E
    \u043A\u0440\u043E\u0432\u044C. \u042F... \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B.
    \u041D\u043E \u043E\u043D\u0438 \u0441\u0430\u043C\u0438 \u0434\u043E\u0432\u0435\u043B\u0438.
    \u041E\u043D\u0438 \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u044B. \u041E\u043D\u0438
    \u043F\u0435\u0440\u0432\u044B\u0435 \u0441\u0434\u0430\u043B\u0438\u0441\u044C.
    \u042F \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u044B\u0436\u0438\u0432\u0430\u044E.
    \u0417\u0432\u0443\u043A\u0438 \u0431\u0435\u0441\u044F\u0442. \u0425\u043E\u0447\u0443
    \u0435\u0441\u0442\u044C."
  - "\u0412 \u0443\u0448\u0430\u0445 \u0437\u0432\u043E\u043D. \u0414\u044B\u0448\u0430\u0442\u044C
    \u0431\u043E\u043B\u044C\u043D\u043E. \u042F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439.
    \u041E\u043D\u0438 \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0438, \u0441\u043B\u0430\u0431\u0430\u043A\u0438.
    \u042F \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F \u0434\u043E\u043B\u044C\u0448\u0435
    \u0432\u0441\u0435\u0445. \u041D\u043E... \u044D\u0442\u043E \u043B\u0438\u0448\u044C
    \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0430. \u0412\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
    \u043A\u043E\u043D\u0435\u0446. \u042F \u043D\u0438 \u0432 \u0447\u0451\u043C
    \u043D\u0435 \u0432\u0438\u043D\u043E\u0432\u0430\u0442."
  text: {fileID: 1875711722}
